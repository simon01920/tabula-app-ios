<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Shared by BOTH build paths. Rules:
  - xtool merges this dict over its generated defaults (CFBundleIdentifier, CFBundleExecutable,
    CFBundleVersion "1", CFBundleShortVersionString "1.0.0", MinimumOSVersion ...).
  - XcodeGen/xcodebuild uses it as INFOPLIST_FILE together with GENERATE_INFOPLIST_FILE=YES, so
    Xcode adds the bundle keys from build settings (PRODUCT_BUNDLE_IDENTIFIER, MARKETING_VERSION ...).
  - Therefore: NO $(VARIABLE) placeholders and NO bundle id/version keys in this file
    (xtool would copy "$(PRODUCT_BUNDLE_IDENTIFIER)" literally and break the app).
  - Usage-description strings here are the English fallbacks; the 12 languages live in
    Resources/InfoPlist.xcstrings (Xcode compiles it; the xtool path generates InfoPlist.strings with
    scripts/infoplist-strings.py). validate_config.py checks the English text is identical in both.
  - No UIDeviceFamily here: Xcode takes it from TARGETED_DEVICE_FAMILY ("1,2" = iPhone + iPad, project.yml) and warned
    "User supplied UIDeviceFamily key in the Info.plist will be overwritten" (first CI run, 2026-10-06).
    The xtool path uses xtool's default [1, 2], the same families.
  - iPad: all four orientations (UISupportedInterfaceOrientations~ipad) and no UIRequiresFullScreen, so the app
    resizes in Split View, Stage Manager and windowed iPadOS (docs/specs/ADAPTIVE_LAYOUT.md; validate_config.py).
-->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Tabula</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>sk</string>
		<string>cs</string>
		<string>pl</string>
		<string>hu</string>
		<string>ro</string>
		<string>de</string>
		<string>fr</string>
		<string>uk</string>
		<string>sr</string>
		<string>sr-Latn</string>
		<string>ja</string>
		<string>zh-Hans</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Phase 3 reminders: BGAppRefreshTask re-plans the rolling notification window. The identifier must equal
	     BackgroundRefreshPolicy.taskIdentifier (TimetableUI; validate_config.py checks it). "Executing app refresh
	     tasks requires setting the fetch UIBackgroundModes capability" (BGAppRefreshTask docs, 2026-10-10). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>sk.simondev.tabula.reminders.refresh</string>
	</array>
	<!-- Phase 6 S1: remote-notification lets CKSyncEngine's silent pushes wake the app ("CKSyncEngine requires the
	     CloudKit and Remote notifications entitlements", CKSyncEngine docs). Harmless without aps-environment (free and
	     xtool builds never receive a push); the entitlement itself stays in Config/Entitlements/PaidAccount. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<!-- Phase 7 H1: the `tabula` scheme. `tabula://import#<envelope>` / `tabula://import?code=<CODE>` come from the share
	     landing page ("Open in Tabula"); `tabula://open/…` are widget links (ItemLinkURL). Both handled in onOpenURL.
	     Universal links need Associated Domains (paid account, PHASE7_PLAN decision 2). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>sk.simondev.tabula</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tabula</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
		</dict>
	</array>
	<key>NSAlarmKitUsageDescription</key>
	<string>Tabula schedules loud alarms only for reminders you explicitly mark as important, such as an exam tomorrow.</string>
	<key>NSCameraUsageDescription</key>
	<string>Tabula uses the camera to scan a printed timetable or a shared timetable's QR code so it can be imported.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Tabula records voice notes that you attach to your tasks.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Tabula reads a photo or screenshot of a timetable you choose so it can be imported.</string>
</dict>
</plist>
