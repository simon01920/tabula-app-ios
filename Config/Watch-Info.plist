<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- watchOS app (XcodeGen/CI path only). Used with GENERATE_INFOPLIST_FILE=YES.
     WKApplication: single-target watchOS app. WKCompanionAppBundleIdentifier: canonical iOS app ID
     (the CI build is never re-signed with the xtool XTL- prefix). -->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Tabula</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>sk</string>
		<string>cs</string>
		<string>pl</string>
		<string>hu</string>
		<string>ro</string>
		<string>de</string>
		<string>fr</string>
		<string>uk</string>
		<string>sr</string>
		<string>sr-Latn</string>
		<string>ja</string>
		<string>zh-Hans</string>
	</array>
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>sk.simondev.tabula</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<false/>
</dict>
</plist>
