<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Shared by both build paths; same rules as App-Info.plist (no $(VARIABLES), no bundle id/version keys).
     WidgetKit is a Foundation NSExtension (com.apple.widgetkit-extension), which xtool supports. -->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Tabula Widgets</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>sk</string>
		<string>cs</string>
		<string>pl</string>
		<string>hu</string>
		<string>ro</string>
		<string>de</string>
		<string>fr</string>
		<string>uk</string>
		<string>sr</string>
		<string>sr-Latn</string>
		<string>ja</string>
		<string>zh-Hans</string>
	</array>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.widgetkit-extension</string>
	</dict>
</dict>
</plist>
