# --- Swift / SwiftPM / xtool ---
.build/
.swiftpm/
/xtool/
**/xtool/
Packages/*/.build/
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
DerivedData/
.bsp/
# generated by scripts/l10n-compile.py for the xtool path (Xcode compiles the catalog itself)
.build-l10n/
*.ipa
*.dSYM*
*.app

# --- Secrets: NEVER commit (use GitHub Actions secrets / git-ignored env files) ---
*.p8
*.p12
*.mobileprovision
*.cer
*.pem
.env
.env.*
!.env.example
secrets/
AuthKey_*.p8

# --- Large local artefacts ---
*.xip
*.gguf
models/

# --- Node (backend Worker, later) ---
node_modules/
.wrangler/

# --- OS / editors ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Claude Code local settings ---
.claude/settings.local.json

# --- Kept local by default (decision D2/D12): third-party App Store screenshots + a screenshot
#     containing a real person's name; the kit zip duplicates files already in the repo.
examples/
tabula-kit.zip
