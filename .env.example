# Every environment variable / GitHub Actions setting Tabula's scripts and CI read. NAMES ONLY: never put values in
# this file. For local overrides copy it to `.env` (git-ignored) and fill in only what you need; secrets never go
# into any file in the repo or into chat. scripts/validate.sh checks this list is complete and value-free.
#
# Identity values (bundle ID, App Group, iCloud container, share domain) are NOT variables: they live in
# Config/AppIdentity.xcconfig. Day-of-enrolment steps: docs/PAID_ACCOUNT_SWITCHOVER.md.

# --- Paid Apple Developer account (GitHub: Settings > Secrets and variables > Actions > Variables) -------------
# 1 = build with Config/Entitlements/PaidAccount/* (CloudKit, push, Time Sensitive, memory limit, universal links).
# GitHub *variable*. Leave unset/0 until the account exists. Local Mac builds: xcodebuild TABULA_PAID_ACCOUNT=1.
TABULA_PAID_ACCOUNT=
# 10-character Team ID. Not secret. GitHub *variable* APPLE_TEAM_ID is what CI uses; CI passes it to xcodebuild
# as TABULA_DEVELOPMENT_TEAM. Only set TABULA_DEVELOPMENT_TEAM yourself for a signed build on a Mac.
APPLE_TEAM_ID=
TABULA_DEVELOPMENT_TEAM=

# --- App Store Connect API key (GitHub *secrets*; never in a file, never in chat) -----------------------------
ASC_KEY_ID=
ASC_ISSUER_ID=
# base64 of AuthKey_<KEYID>.p8 (see docs/PAID_ACCOUNT_SWITCHOVER.md for the clipboard-only command)
ASC_KEY_P8_BASE64=

# --- Local build knobs (WSL) ----------------------------------------------------------------------------------
# 1 = build the macro-probe variant (set by `scripts/xtool-dev.sh --macro-probes`; do not export globally)
TABULA_MACRO_PROBES=
# ext4 work dir for xtool builds (default ~/.cache/tabula/work; macro variant appends -macro)
TABULA_WORKDIR=
# SwiftPM scratch root for tests/validation (default ~/.cache/tabula)
TABULA_SCRATCH=
# explicit path to swiftly's env.sh if it is not in ~/.local/share/swiftly (scripts/lib/toolchain.sh)
TABULA_SWIFTLY_ENV=
# Darwin SDK bundle installed by `xtool sdk install` (default ~/.swiftpm/swift-sdks/darwin.artifactbundle)
TABULA_DARWIN_SDK=
# target for scripts/watch-typecheck.sh (default arm64_32-apple-watchos26.0)
TABULA_WATCH_TARGET=
# path to an xcodegen binary for scripts/validate.sh (default: PATH, then ~/.cache/tabula/XcodeGen build)
XCODEGEN=
