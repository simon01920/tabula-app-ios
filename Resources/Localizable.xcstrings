    "reminders.permission.why" : {
      "comment" : "Explains why the notification permission is needed, shown before the system prompt.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aby vám Tabula mohla včas připomínat, potřebuje povolení k odesílání oznámení. iOS se vás zeptá hned poté."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um dich rechtzeitig zu erinnern, braucht Tabula die Erlaubnis, Mitteilungen zu senden. iOS fragt dich als Nächstes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To remind you in time, Tabula needs your permission to send notifications. iOS will ask you next."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour vous rappeler à temps, Tabula a besoin de votre autorisation pour envoyer des notifications. iOS vous la demandera ensuite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hogy időben emlékeztethessen, a Tabulának engedélyre van szüksége az értesítések küldéséhez. Az iOS ezután rákérdez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "期限に間に合うようお知らせするため、Tabulaには通知を送信する許可が必要です。この後、iOSが確認します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aby przypominać Ci na czas, Tabula potrzebuje zgody na wysyłanie powiadomień. iOS zapyta o nią za chwilę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pentru a te reaminti la timp, Tabula are nevoie de permisiunea de a trimite notificări. iOS te va întreba imediat după."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aby vám Tabula mohla pripomenúť veci včas, potrebuje povolenie na odosielanie oznámení. iOS sa vás opýta hneď potom."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Да би вас подсетила на време, Tabula треба дозволу да шаље обавештења. iOS ће вас питати следеће."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Da bi vas podsetila na vreme, Tabula treba dozvolu da šalje obaveštenja. iOS će vas pitati sledeće."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Щоб нагадувати вчасно, Tabula потрібен дозвіл надсилати сповіщення. Далі iOS запитає вас про це."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "为了及时提醒你，Tabula 需要获得发送通知的权限。接下来 iOS 会向你询问。"
