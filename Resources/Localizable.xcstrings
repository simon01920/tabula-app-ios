    "onboarding.rotation.anchorNote" : {
      "comment" : "Onboarding: note under the cycle-length stepper explaining which week is week 1.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
