    "onboarding.fields.subtitle" : {
      "comment" : "Onboarding fields step explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zapněte jen to, co používáte. Skryté údaje zmizí všude, včetně editoru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schalte nur ein, was du brauchst. Ausgeblendete Angaben verschwinden überall, auch im Editor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch on only what you use. Hidden details disappear everywhere, including the editor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activez seulement ce que vous utilisez. Les détails masqués disparaissent partout, y compris de l’éditeur."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Csak azt kapcsold be, amit használsz. A rejtett adatok mindenhol eltűnnek, a szerkesztőből is."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使う項目だけオンにしてください。非表示にした項目は、エディタを含むすべての画面で表示されなくなります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Włącz tylko to, czego używasz. Ukryte szczegóły znikną wszędzie, także z edytora."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activează doar ce folosești. Detaliile ascunse dispar peste tot, inclusiv din editor."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zapnite len to, čo používate. Skryté údaje zmiznú všade vrátane editora."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Укључите само оно што користите. Сакривени детаљи нестају свуда, укључујући и уређивач."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uključite samo ono što koristite. Sakriveni detalji nestaju svuda, uključujući i uređivač."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вмикайте лише те, чим користуєтеся. Приховані відомості зникнуть усюди, зокрема з редактора."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "只开启你会用到的项目。隐藏的内容会在所有地方消失，包括编辑器。"
          }
        }
      }
    },
