    "settings.reminders.alarm.detail" : {
      "comment" : "Explanation of the loud alarm reminder type.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zvoní jako budík, i když je telefon v tichém režimu nebo v Soustředění. Vyžaduje vaše povolení a je funkcí Pro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Klingelt wie ein Wecker, auch wenn das iPhone stumm geschaltet ist oder ein Fokus aktiv ist. Benötigt deine Erlaubnis und ist eine Pro-Funktion."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rings like an alarm clock, even when the phone is on silent or in a Focus. Needs your permission and is a Pro feature."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sonne comme un réveil, même quand le téléphone est en silencieux ou en mode Concentration. Nécessite votre autorisation et fait partie de Pro."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Úgy szól, mint egy ébresztőóra, akkor is, ha a telefon néma módban van vagy Fókusz be van kapcsolva. Engedélyed kell hozzá, és Pro funkció."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dzwoni jak budzik, nawet gdy telefon jest wyciszony lub w trybie skupienia. Wymaga Twojej zgody i jest funkcją Pro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sună ca un ceas deșteptător, chiar și când telefonul e pe silențios sau în Concentrare. Necesită permisiunea ta și este o funcție Pro."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zvoní ako budík, aj keď je telefón v tichom režime alebo v režime Sústredenie. Vyžaduje vaše povolenie a je funkciou Pro."
          }
        }
      }
    },
    "settings.reminders.alarm.title" : {
      "comment" : "Reminder type name: alarm that rings loudly.",
      "extractionState" : "manual",
      "localizations" : {
