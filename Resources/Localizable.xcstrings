          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az alkalmazás az iPhone nyelvét használja. Ehhez az alkalmazáshoz a Beállításokban másik nyelvet is választhatsz."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
