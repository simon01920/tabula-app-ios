    "onboarding.welcome.language.message" : {
      "comment" : "Onboarding welcome: explains that the app follows the system language and the per-app language setting exists.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikace používá jazyk vašeho iPhonu. Jiný jazyk pro tuto aplikaci můžete vybrat v Nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die App verwendet die Sprache deines iPhone. Für diese App kannst du in den Einstellungen eine andere Sprache wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app uses your iPhone's language. You can choose a different language for this app in Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’app utilise la langue de votre iPhone. Vous pouvez choisir une autre langue pour cette app dans les Réglages."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az alkalmazás az iPhone nyelvét használja. Ehhez az alkalmazáshoz a Beállításokban másik nyelvet is választhatsz."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このアプリはiPhoneの言語を使用します。このアプリだけ別の言語にするには、設定で選択できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikacja używa języka Twojego iPhone'a. Inny język dla tej aplikacji możesz wybrać w Ustawieniach."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplicația folosește limba iPhone-ului tău. Poți alege o altă limbă pentru această aplicație în Setări."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikácia používa jazyk vášho iPhonu. Iný jazyk pre túto aplikáciu si môžete vybrať v Nastaveniach."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Апликација користи језик вашег iPhone-а. Други језик за ову апликацију можете изабрати у Подешавањима."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikacija koristi jezik vašeg iPhone-a. Drugi jezik za ovu aplikaciju možete izabrati u Podešavanjima."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Застосунок використовує мову вашого iPhone. Іншу мову для цього застосунку можна вибрати в Параметрах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "App 使用你 iPhone 的语言。你可以在“设置”中为此 App 选择其他语言。"
          }
        }
      }
    },
