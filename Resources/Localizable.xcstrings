          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A hangos riasztások nem szólalnak meg, ha a Tabula el van rejtve vagy Face ID-val van zárolva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
