    "editor.subject.delete.note" : {
      "comment" : "Explanation in the delete-subject confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Smažou se i jeho hodiny. Domácí úkoly a zkoušky tohoto předmětu zůstanou, ale ztratí propojení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seine Stunden werden ebenfalls gelöscht. Hausaufgaben und Prüfungen dieses Fachs bleiben erhalten, verlieren aber die Verknüpfung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its lessons are deleted too. Homework and exams of this subject are kept but lose the link."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ses cours sont aussi supprimés. Les devoirs et examens de cette matière sont conservés mais perdent leur lien."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az órái is törlődnek. A tantárgy házi feladatai és vizsgái megmaradnak, de megszűnik a kapcsolatuk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この科目の授業も削除されます。この科目の宿題と試験は残りますが、関連付けは外れます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jego lekcje też zostaną usunięte. Prace domowe i egzaminy z tego przedmiotu zostaną, ale stracą powiązanie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Orele ei se șterg și ele. Temele și examenele acestei materii se păstrează, dar își pierd legătura."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odstránia sa aj jeho hodiny. Domáce úlohy a skúšky tohto predmetu zostanú, ale stratia prepojenie."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Његови часови се такође бришу. Домаћи задаци и испити из овог предмета се задржавају, али губе везу."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Njegovi časovi se takođe brišu. Domaći zadaci i ispiti iz ovog predmeta se zadržavaju, ali gube vezu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Його уроки також буде видалено. Домашні завдання та іспити з цього предмета збережуться, але втратять зв’язок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "其课程也会被删除。此科目的作业和考试会保留，但会解除关联。"
          }
        }
      }
    },
