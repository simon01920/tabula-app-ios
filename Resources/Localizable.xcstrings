    "onboarding.welcome.message" : {
      "comment" : "Onboarding welcome screen body.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Několik rychlých otázek nastaví váš rozvrh. Každou odpověď můžete později změnit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein paar kurze Fragen richten deinen Stundenplan ein. Jede Antwort kannst du später ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A few quick questions set up your timetable. You can change every answer later."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quelques questions rapides configurent votre emploi du temps. Vous pourrez modifier chaque réponse plus tard."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Néhány gyors kérdés beállítja az órarendedet. Bármelyik választ később módosíthatod."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kilka szybkich pytań skonfiguruje Twój plan. Każdą odpowiedź możesz później zmienić."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Câteva întrebări rapide îți configurează orarul. Poți schimba orice răspuns mai târziu."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pár rýchlych otázok nastaví váš rozvrh. Každú odpoveď môžete neskôr zmeniť."
          }
        }
      }
    },
