    "onboarding.reminders.tier.standard.body" : {
      "comment" : "Honest explanation of standard notifications, silent switch and Focus.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Běžné oznámení. Při zapnutém tichém režimu iPhonu je tiché a režimy Soustředění ho mohou zadržet, pokud této aplikaci nepovolíte výjimku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine normale Mitteilung. Sie ist stumm, wenn der Stummschalter des iPhone aktiv ist, und Fokus-Modi können sie zurückhalten, sofern du diese App dort nicht erlaubst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A normal notification. It is silent when your iPhone's silent switch is on, and Focus modes can hold it back unless you allow this app there."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une notification normale. Elle est silencieuse lorsque le bouton silence de l’iPhone est activé, et les modes de concentration peuvent la retenir si vous n’y autorisez pas cette app."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Egy szokásos értesítés. Az iPhone néma kapcsolójával néma, és a Fókusz módok visszatarthatják, ha nem engedélyezed ezt az alkalmazást."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zwykłe powiadomienie. Jest ciche, gdy przełącznik wyciszenia iPhone'a jest włączony, a tryby skupienia mogą je wstrzymać, jeśli nie dopuścisz tej aplikacji."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O notificare obișnuită. Este silențioasă când comutatorul de sunet al iPhone-ului este oprit, iar modurile Concentrare o pot reține, dacă nu permiți această aplicație acolo."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bežné oznámenie. Pri zapnutom tichom režime iPhonu je tiché a režimy Sústredenie ho môžu zadržať, pokiaľ tejto aplikácii neumožníte výnimku."
          }
        }
      }
    },
