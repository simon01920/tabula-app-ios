    "reminders.quiet.rule.footer" : {
      "comment" : "Footer under the rule's quiet hours.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Připomínky v těchto hodinách se přesunou na konec tohoto období. Pokud by to bylo po termínu, připomínka se vynechá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erinnerungen in diesem Zeitraum werden auf dessen Ende verschoben. Läge das nach der Fälligkeit, entfällt die Erinnerung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reminders inside these hours are moved to when they end. If that is after the due time, the reminder is skipped."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rappels pendant ces heures sont décalés à leur fin. Si cela tombe après l’échéance, le rappel est ignoré."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az ebbe az idősávba eső emlékeztetők a végére tolódnak. Ha ez a határidő utánra esne, az emlékeztető kimarad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この時間帯のリマインダーは、終了時刻に移動されます。期限を過ぎてしまう場合、そのリマインダーはスキップされます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przypomnienia w tych godzinach są przesuwane na ich koniec. Jeśli byłoby to po terminie, przypomnienie jest pomijane."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reamintirile din acest interval sunt mutate la sfârșitul lui. Dacă asta ar fi după termen, reamintirea este omisă."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pripomienky v týchto hodinách sa presunú na koniec tohto obdobia. Ak by to bolo po termíne, pripomienka sa preskočí."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Подсетници у ово време померају се на његов крај. Ако би то било после рока, подсетник се прескаче."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podsetnici u ovo vreme pomeraju se na njegov kraj. Ako bi to bilo posle roka, podsetnik se preskače."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нагадування в ці години переносяться на їх завершення. Якщо це після терміну, нагадування пропускається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
