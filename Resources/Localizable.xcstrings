    "settings.reminders.focus.detail" : {
      "comment" : "Explains Focus modes.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Soustředění může standardní připomínky skrýt nebo zpozdit. Které aplikace a osoby smějí rušit, vyberete v Nastavení iOS v části Soustředění."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Fokus kann Standard-Erinnerungen ausblenden oder verzögern. Welche Apps und Personen dich unterbrechen dürfen, wählst du in den iOS-Einstellungen unter „Fokus“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Focus can hide or delay Standard reminders. Choose which apps and people may interrupt in iOS Settings under Focus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une Concentration peut masquer ou retarder les rappels standard. Choisissez quelles apps et quelles personnes peuvent vous interrompre dans Réglages d’iOS > Concentration."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Fókusz elrejtheti vagy késleltetheti a normál emlékeztetőket. Az iOS Beállítások Fókusz részében választhatod ki, mely alkalmazások és személyek zavarhatnak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tryb skupienia może ukrywać lub opóźniać przypomnienia standardowe. Aplikacje i osoby, które mogą przerywać, wybierzesz w Ustawieniach iOS w sekcji Skupienie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Concentrarea poate ascunde sau amâna reamintirile standard. Alege ce aplicații și persoane pot întrerupe în Setările iOS, la Concentrare."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Režim Sústredenie môže štandardné pripomienky skryť alebo oneskoriť. Ktoré aplikácie a osoby smú rušiť, vyberiete v Nastaveniach iOS v časti Sústredenie."
          }
        }
      }
    },
    "settings.reminders.later" : {
      "comment" : "Note at the bottom of the reminders page.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Připomínky se nastavují v pozdější aktualizaci. Zatím není nic naplánováno a Tabula nepožádala o žádné oprávnění."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erinnerungen werden in einem späteren Update konfiguriert. Es ist noch nichts geplant, und Tabula hat keine Erlaubnis angefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reminders are configured in a later update. Nothing is scheduled yet, and Tabula has not asked for any permission."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rappels seront configurables dans une prochaine mise à jour. Rien n’est encore programmé et Tabula n’a demandé aucune autorisation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az emlékeztetők beállítása egy későbbi frissítésben érkezik. Még semmi sincs ütemezve, és a Tabula nem kért engedélyt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przypomnienia będą konfigurowane w późniejszej aktualizacji. Nic jeszcze nie jest zaplanowane, a Tabula nie prosiła o żadne zgody."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reamintirile se configurează într-o actualizare ulterioară. Nimic nu este programat încă, iar Tabula nu a cerut nicio permisiune."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pripomienky sa nastavujú v neskoršej aktualizácii. Zatiaľ nie je nič naplánované a Tabula nepožiadala o žiadne povolenie."
          }
        }
      }
    },
    "settings.reminders.row" : {
      "comment" : "Settings row that opens the page explaining reminder types.",
