        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twoje zmiany są zachowane, dopóki Tabula jest otwarta, a zapis zostanie ponowiony przy kolejnej zmianie. Sprawdź, czy iPhone ma wolne miejsce."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modificările tale sunt păstrate cât timp Tabula e deschisă, iar salvarea se reîncearcă la următoarea modificare. Verifică dacă iPhone-ul are spațiu liber."
