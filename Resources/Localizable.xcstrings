          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az órák időpontja mindig ezt az időzónát használja, akkor is, ha az eszközöd máshol van."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
