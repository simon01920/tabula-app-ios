    "reminders.followUp.footer" : {
      "comment" : "Footer of the follow-up section in the rule editor.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odešle se, jen pokud položka stále není hotová. Opakovaná připomínka nikdy není hlasitý budík."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wird nur gesendet, wenn der Eintrag noch nicht erledigt ist. Eine Nachfass-Erinnerung ist nie ein lauter Alarm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent only if the item is still not done. A follow-up is never a loud alarm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envoyé uniquement si l’élément n’est toujours pas terminé. Un rappel de suivi n’est jamais une alarme sonore."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Csak akkor érkezik, ha a tétel még nincs kész. Az ismételt emlékeztető sosem hangos riasztás."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "項目がまだ完了していない場合にのみ送信されます。再通知が大音量アラームになることはありません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wysyłane tylko wtedy, gdy pozycja nadal nie jest ukończona. Kolejne przypomnienie nigdy nie jest głośnym alarmem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se trimite doar dacă elementul tot nu este terminat. O reamintire ulterioară nu este niciodată o alarmă sonoră."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odošle sa, iba ak položka stále nie je hotová. Opakovaná pripomienka nikdy nie je hlasný budík."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Шаље се само ако ставка још није готова. Накнадни подсетник никада није гласан аларм."
