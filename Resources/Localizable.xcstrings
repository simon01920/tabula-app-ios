{
  "sourceLanguage" : "en",
  "strings" : {
    "a11y.lesson.added" : {
      "comment" : "VoiceOver phrase at the end of a lesson description: one-off lesson added for this day.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "extra lesson"
          }
        }
      }
    },
    "a11y.lesson.bring" : {
      "comment" : "Phrase for things to bring to the lesson (VoiceOver and lesson rows). Arg 1 = a formatted list, e.g. 'sports kit and water'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bring %@"
          }
        }
      }
    },
    "a11y.lesson.building" : {
      "comment" : "VoiceOver phrase: the lesson's building or faculty. Arg 1 = user text.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "building %@"
          }
        }
      }
    },
    "a11y.lesson.cancelled" : {
      "comment" : "VoiceOver phrase at the end of a lesson description: the lesson does not take place.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cancelled"
          }
        }
      }
    },
    "a11y.lesson.modified" : {
      "comment" : "VoiceOver phrase at the end of a lesson description: the lesson differs from the regular timetable today.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "changed"
          }
        }
      }
    },
    "a11y.lesson.modifiedReasons" : {
      "comment" : "VoiceOver phrase: what changed for this lesson today. Arg 1 = a formatted list of changes, e.g. 'Room changed and Teacher changed'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "changed: %@"
          }
        }
      }
    },
    "a11y.lesson.notes" : {
      "comment" : "VoiceOver phrase: the lesson's note. Arg 1 = note text entered by the user.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "note: %@"
          }
        }
      }
    },
    "a11y.lesson.period" : {
      "comment" : "VoiceOver phrase in a lesson description: the lesson's period number, e.g. 'period 2' (Slovak: '2. hodina'). Arg 1 = number. Lowercase unless the language capitalises mid-sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "period %lld"
          }
        }
      }
    },
    "a11y.lesson.periodLabel" : {
      "comment" : "VoiceOver phrase: the lesson's period with a custom label from the bell schedule. Arg 1 = label text.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "period %@"
          }
        }
      }
    },
    "a11y.lesson.room" : {
      "comment" : "Phrase for the lesson's room (VoiceOver and lesson rows). Arg 1 = room name/number entered by the user.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "room %@"
          }
        }
      }
    },
    "a11y.lesson.teacher" : {
      "comment" : "VoiceOver phrase: the lesson's teacher. Arg 1 = teacher name entered by the user.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "teacher %@"
          }
        }
      }
    },
    "a11y.lesson.time" : {
      "comment" : "VoiceOver phrase: lesson time range. Arg 1 = start time, arg 2 = end time (already formatted, e.g. '8:55', '9:40').",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ to %2$@"
          }
        }
      }
    },
    "a11y.separator" : {
      "comment" : "VoiceOver: separator between the phrases describing one lesson (subject, period, time, room…). Use the language's list separator, e.g. '、' in Japanese. Keep the trailing space where the language uses one.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", "
          }
        }
      }
    },
