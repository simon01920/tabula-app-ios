    "editor.bell.variants.footer" : {
      "comment" : "Explanation of weekday-specific schedules.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nový rozvrh vznikne jako kopie běžného. Hodiny si ponechají svá pořadí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der neue Plan beginnt als Kopie des regulären. Stunden behalten ihre Zeitfenster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A copy of the regular schedule starts the new schedule. Lessons keep their periods."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
