    "editor.timetables.reset.note" : {
      "comment" : "Explanation in the reset confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rozvrh, jeho předměty, rozvrhy zvonění a období zůstanou. Vymažou se jen hodiny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Stundenplan, seine Fächer, Klingelpläne und Zeiträume bleiben. Nur die Stunden werden geleert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The timetable, its subjects, bell schedules and terms stay. Only the lessons are cleared."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’emploi du temps, ses matières, ses horaires de sonnerie et ses périodes restent. Seuls les cours sont effacés."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az órarend, a tantárgyai, a csengetési rendjei és az időszakai megmaradnak. Csak az órák törlődnek."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "時間割、その科目、時限表、学期は残ります。授業だけが消去されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plan, jego przedmioty, plany dzwonków i okresy zostają. Wyczyszczone zostaną tylko zajęcia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Orarul, materiile, programele de sonerie și perioadele rămân. Se șterg doar orele."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rozvrh, jeho predmety, rozvrhy zvonenia a obdobia zostanú. Vymažú sa len hodiny."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Распоред, његови предмети, распореди звона и периоди остају. Бришу се само часови."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Raspored, njegovi predmeti, rasporedi zvona i periodi ostaju. Brišu se samo časovi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Розклад, його предмети, розклади дзвінків і періоди залишаться. Буде очищено лише уроки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "课程表、其科目、作息时间表和学期会保留。仅清除课程。"
          }
        }
      }
    },
