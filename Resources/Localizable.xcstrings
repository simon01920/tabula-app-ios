    "settings.about.privacy.body" : {
      "comment" : "Short privacy summary.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaše rozvrhy zůstávají ve vašem zařízení. Tabula nemá účty a neshromažďuje žádná analytická data ani data o používání."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Stundenpläne bleiben auf deinem Gerät. Tabula hat keine Konten und erfasst keine Analyse- oder Nutzungsdaten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your timetables stay on your device. Tabula has no accounts and collects no analytics or usage data."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vos emplois du temps restent sur votre appareil. Tabula n’a pas de comptes et ne collecte aucune donnée d’analyse ni d’utilisation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az órarendjeid az eszközödön maradnak. A Tabulának nincsenek fiókjai, és nem gyűjt elemzési vagy használati adatokat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "時間割はあなたのデバイスに保存されます。Tabulaにはアカウントがなく、分析データや利用状況データを収集することもありません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twoje plany pozostają na Twoim urządzeniu. Tabula nie ma kont i nie zbiera danych analitycznych ani danych o użyciu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Orarele tale rămân pe dispozitivul tău. Tabula nu are conturi și nu colectează date analitice sau de utilizare."
