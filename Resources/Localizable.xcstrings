    "reminders.tier.alarm.footer" : {
      "comment" : "Footer under the selected Loud alarm tier.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zvoní jen v časech, které tu nastavíte, a jen u připomínek, které jste vytvořili sami. Vyžaduje vlastní povolení. Opakované připomínky nejsou nikdy hlasité budíky a tiché hodiny tohoto druhu stále platí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Klingelt nur zu den Zeiten, die du hier festlegst, und nur bei Erinnerungen, die du selbst erstellt hast. Dafür ist eine eigene Erlaubnis nötig. Nachfass-Erinnerungen sind nie laute Alarme, und die Ruhezeiten dieser Art gelten weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rings only at the times you set here, and only for reminders you made yourself. It needs its own permission. Follow-ups are never loud alarms, and quiet hours of this kind still apply."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sonne uniquement aux heures que vous définissez ici, et seulement pour les rappels que vous avez créés vous-même. Nécessite sa propre autorisation. Les rappels de suivi ne sont jamais des alarmes sonores, et les heures calmes de ce type s’appliquent toujours."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Csak az itt beállított időpontokban szólal meg, és csak a saját magad létrehozta emlékeztetőknél. Külön engedélyt igényel. Az ismételt emlékeztetők sosem hangos riasztások, és az ehhez a típushoz tartozó csendes órák továbbra is érvényesek."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ここで設定した時刻にだけ鳴り、自分で作成したリマインダーに限られます。別途許可が必要です。再通知が大音量アラームになることはなく、このタイプのおやすみ時間も引き続き適用されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dzwoni tylko o ustawionych tu porach i tylko dla przypomnień, które sam utworzysz. Wymaga osobnej zgody. Kolejne przypomnienia nigdy nie są głośnymi alarmami, a godziny ciszy dla tego rodzaju nadal obowiązują."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sună doar la orele pe care le setezi aici și doar pentru reamintirile create de tine. Are nevoie de propria permisiune. Reamintirile ulterioare nu sunt niciodată alarme sonore, iar orele de liniște ale acestui tip se aplică în continuare."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zvoní iba v časoch, ktoré tu nastavíte, a iba pri pripomienkach, ktoré ste vytvorili sami. Vyžaduje vlastné povolenie. Opakované pripomienky nie sú nikdy hlasné budíky a pokojné hodiny tohto druhu stále platia."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Звони само у време које овде подесите и само за подсетнике које сте сами направили. Потребна је посебна дозвола. Накнадни подсетници никада нису гласни аларми, а тихи сати ове врсте и даље важе."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zvoni samo u vreme koje ovde podesite i samo za podsetnike koje ste sami napravili. Potrebna je posebna dozvola. Naknadni podsetnici nikada nisu glasni alarmi, a tihi sati ove vrste i dalje važe."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дзвонить лише в години, які ви тут задали, і лише для нагадувань, створених вами самостійно. Потрібен окремий дозвіл. Повторні нагадування ніколи не бувають гучними будильниками, а тихі години цього типу й надалі діють."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "只在你在此设置的时间响铃，且仅限你自己创建的提醒。需要单独的权限。再次提醒不会是响铃闹钟，此类型的静音时段仍然有效。"
          }
        }
      }
    },
