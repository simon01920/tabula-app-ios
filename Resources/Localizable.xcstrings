    "onboarding.rotation.anchorNote" : {
      "comment" : "Onboarding: note under the cycle-length stepper explaining which week is week 1.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Týden 1 je týden, ve kterém období začíná, nebo tento týden, pokud data období přeskočíte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Woche 1 ist die Woche, in der der Zeitraum beginnt, oder die aktuelle Woche, wenn du die Zeitraumdaten überspringst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Week 1 is the week the term starts, or this week if you skip the term dates."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La semaine 1 est la semaine où commence la période, ou la semaine en cours si vous ignorez les dates de la période."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az 1. hét az időszak kezdőhete, vagy a mostani hét, ha kihagyod az időszak dátumait."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "第1週は学期が始まる週です。学期の日付を入力しない場合は、今週が第1週になります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tydzień 1 to tydzień rozpoczęcia okresu lub bieżący tydzień, jeśli pominiesz daty okresu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Săptămâna 1 este săptămâna în care începe perioada sau săptămâna aceasta, dacă sari peste datele perioadei."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Týždeň 1 je týždeň, v ktorom sa začína obdobie, alebo tento týždeň, ak dátumy obdobia preskočíte."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Прва седмица је седмица у којој период почиње, или ова седмица ако прескочите датуме периода."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prva sedmica je sedmica u kojoj period počinje, ili ova sedmica ako preskočite datume perioda."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тиждень 1 — це тиждень початку періоду або поточний тиждень, якщо пропустити дати періоду."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "第1周是学期开始的那一周；如果跳过学期日期，则以本周为第1周。"
          }
        }
      }
    },
