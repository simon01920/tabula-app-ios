    "editor.rotation.footer" : {
      "comment" : "Footer under the rotation picker.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Střídavé týdny použijte pro A/B nebo liché/sudé týdny a cyklus dnů pro školy, které své dny číslují."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwende wechselnde Wochen für A/B- oder ungerade/gerade Wochen und einen Tageszyklus für Schulen, die ihre Tage nummerieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use alternating weeks for A/B or odd/even weeks, and a day cycle for schools that number their days."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisez des semaines alternées pour des semaines A/B ou impaires/paires, et un cycle de jours pour les établissements qui numérotent leurs jours."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A váltakozó heteket A/B vagy páratlan/páros hetekhez használd, a napciklust pedig azoknál az iskoláknál, amelyek számozzák a napjaikat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A/B週や奇数/偶数週には週の交替を、日に番号を付ける学校には日のサイクルを使います。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Użyj naprzemiennych tygodni dla A/B lub tygodni nieparzystych/parzystych, a cyklu dni dla szkół, które numerują dni."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folosește săptămâni alternante pentru săptămâni A/B sau impare/pare și un ciclu de zile pentru școlile care își numerotează zilele."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Striedavé týždne použite pre A/B alebo nepárne/párne týždne a cyklus dní pre školy, ktoré svoje dni číslujú."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Користите смењивање седмица за A/B или непарне/парне седмице, а циклус дана за школе које нумеришу дане."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koristite smenjivanje sedmica za A/B ili neparne/parne sedmice, a ciklus dana za škole koje numerišu dane."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Використовуйте чергування тижнів для тижнів A/B чи непарних/парних, а цикл днів — для закладів, що нумерують дні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
