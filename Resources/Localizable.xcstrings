    "store.banner.saveFailed.message" : {
      "comment" : "Banner text under 'Couldn't save'.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaše změny se zachovají, dokud je Tabula otevřená, a ukládání se zopakuje při další změně. Zkontrolujte, zda má váš iPhone volné úložiště."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Änderungen bleiben erhalten, solange Tabula geöffnet ist, und das Speichern wird bei deiner nächsten Änderung erneut versucht. Prüfe, ob dein iPhone freien Speicherplatz hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your changes are kept while Tabula is open and saving is retried with your next change. Check that your iPhone has free storage."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vos modifications sont conservées tant que Tabula est ouverte et l’enregistrement sera retenté à votre prochaine modification. Vérifiez que votre iPhone dispose de suffisamment d’espace de stockage."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A módosításaid addig megmaradnak, amíg a Tabula nyitva van, és a mentést a következő módosításnál újra megpróbáljuk. Ellenőrizd, hogy van-e szabad hely az iPhone-odon."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabulaを開いている間は変更が保持され、次の変更時に保存が再試行されます。iPhoneの空き容量を確認してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twoje zmiany są zachowane, dopóki Tabula jest otwarta, a zapis zostanie ponowiony przy kolejnej zmianie. Sprawdź, czy iPhone ma wolne miejsce."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modificările tale sunt păstrate cât timp Tabula e deschisă, iar salvarea se reîncearcă la următoarea modificare. Verifică dacă iPhone-ul are spațiu liber."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaše zmeny sa zachovajú, kým je Tabula otvorená, a ukladanie sa zopakuje pri ďalšej zmene. Skontrolujte, či má váš iPhone voľné úložisko."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваше измене се чувају док је Tabula отворена, а чување ће бити поновљено при следећој измени. Проверите да ли iPhone има слободног простора."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaše izmene se čuvaju dok je Tabula otvorena, a čuvanje će biti ponovljeno pri sledećoj izmeni. Proverite da li iPhone ima slobodnog prostora."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваші зміни зберігаються, доки Tabula відкрита, а збереження буде повторено після наступної зміни. Перевірте, чи є на iPhone вільне місце."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
