    "settings.reminders.timeSensitive.footer" : {
      "comment" : "Footer of the Time Sensitive settings.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Časově citlivé může prolomit Soustředění, ale ne tichý režim. Připomínky dříve, než je tento limit, přijdou jako standardní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeitkritisch kann einen Fokus durchbrechen, aber nicht den Stummschalter. Erinnerungen, die früher als dieses Limit liegen, kommen als Standard an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Sensitive can break through a Focus, but not the silent switch. Reminders earlier than this limit arrive as Standard."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Urgentes peut passer malgré une Concentration, mais pas le bouton silence. Les rappels plus tôt que cette limite arrivent en standard."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az időérzékeny áttörheti a Fókuszt, de a néma kapcsolót nem. Az ennél a korlátnál korábbi emlékeztetők normálként érkeznek."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "即時通知は集中モードを通り抜けられますが、サイレントスイッチは超えられません。この上限より早いリマインダーは通常として届きます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilne mogą przebić się przez tryb skupienia, ale nie przez przełącznik wyciszenia. Przypomnienia wcześniejsze niż ten limit przychodzą jako standardowe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Urgentele pot trece prin Concentrare, dar nu prin comutatorul silențios. Reamintirile mai devreme decât această limită ajung ca standard."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Časovo citlivé môže prelomiť Sústredenie, ale nie tichý režim. Pripomienky skôr, než je tento limit, prídu ako štandardné."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хитно може да прође кроз Фокус, али не и кроз прекидач за тишину. Подсетници раније од овог ограничења стижу као стандардни."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hitno može da prođe kroz Fokus, ali ne i kroz prekidač za tišinu. Podsetnici ranije od ovog ograničenja stižu kao standardni."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Термінові можуть пробитися крізь фокусування, але не крізь перемикач без звуку. Нагадування раніше за цей ліміт надходять як стандартні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "时效性通知可以突破专注模式，但不能突破静音开关。早于此限制的提醒将以标准方式送达。"
          }
        }
      }
    },
