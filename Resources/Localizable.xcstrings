    "store.problem.unrecoverable.message" : {
      "comment" : "Text under 'Your data can't be opened'.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula nedokázala přečíst váš rozvrh ani jeho zálohu. Nic nebylo smazáno. Obnovení z iCloudu nebo ze souboru se zálohou bude možné v pozdější verzi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula konnte deinen Stundenplan und dessen Backup nicht lesen. Es wurde nichts gelöscht. Die Wiederherstellung aus iCloud oder einer Backup-Datei wird in einer späteren Version möglich sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabula couldn't read your timetable or its backup. Nothing was deleted. Restoring from iCloud or a backup file will be possible in a later version."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula n’a pas pu lire votre emploi du temps ni sa sauvegarde. Rien n’a été supprimé. La restauration depuis iCloud ou un fichier de sauvegarde sera possible dans une version ultérieure."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Tabula nem tudta beolvasni az órarendedet és annak biztonsági mentését sem. Semmi sem lett törölve. Az iCloudból vagy biztonsági mentési fájlból való visszaállítás egy későbbi verzióban lesz elérhető."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabulaは時間割もそのバックアップも読み取れませんでした。何も削除されていません。iCloudやバックアップファイルからの復元は、今後のバージョンで可能になります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula nie mogła odczytać Twojego planu ani jego kopii zapasowej. Nic nie zostało usunięte. Przywracanie z iCloud lub z pliku kopii będzie możliwe w późniejszej wersji."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula nu a putut citi orarul tău sau copia lui de rezervă. Nu s-a șters nimic. Restaurarea din iCloud sau dintr-un fișier de rezervă va fi posibilă într-o versiune ulterioară."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula nedokázala prečítať váš rozvrh ani jeho zálohu. Nič sa nevymazalo. Obnovenie z iCloudu alebo zo súboru so zálohou bude možné v neskoršej verzii."
          }
        },
        "sr" : {
          "stringUnit" : {
