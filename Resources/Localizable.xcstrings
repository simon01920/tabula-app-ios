    "editor.warning.periodInFreeForm" : {
      "comment" : "Warning after switching a timetable to free-form times while lessons still use bell-schedule periods (plural on the lesson count, arg 1). Lessons are not placed in the timetable.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "%lld hodiny používají časy z rozvrhu zvonění, které volné časy nemají. Nezobrazí se, dokud jim nenastavíte začátek a konec nebo se nevrátíte k rozvrhu zvonění."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "%lld hodiny používají časy z rozvrhu zvonění, které volné časy nemají. Nezobrazí se, dokud jim nenastavíte začátek a konec nebo se nevrátíte k rozvrhu zvonění."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "%lld hodina používá čas z rozvrhu zvonění, který volné časy nemají. Nezobrazí se, dokud jí nenastavíte začátek a konec nebo se nevrátíte k rozvrhu zvonění."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "%lld hodin používá časy z rozvrhu zvonění, které volné časy nemají. Nezobrazí se, dokud jim nenastavíte začátek a konec nebo se nevrátíte k rozvrhu zvonění."
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "%lld Stunde ist einer Stunde des Klingelplans zugeordnet, den ein Stundenplan mit freien Zeiten nicht hat. Sie wird nicht angezeigt, bis du ihr Start- und Endzeit gibst oder zum Klingelplan zurückwechselst."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "%lld Stunden sind Stunden des Klingelplans zugeordnet, den ein Stundenplan mit freien Zeiten nicht hat. Sie werden nicht angezeigt, bis du ihnen Start- und Endzeiten gibst oder zum Klingelplan zurückwechselst."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld lesson is set to a bell-schedule period, which a free-form timetable does not have. It is not shown until you give it a start and end time or switch back to a bell schedule."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld lessons are set to bell-schedule periods, which a free-form timetable does not have. They are not shown until you give them a start and end time or switch back to a bell schedule."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "%lld cours est lié à une plage des horaires de sonnerie, que les horaires libres n’ont pas. Il n’apparaît pas tant que vous ne lui donnez pas une heure de début et de fin ou que vous ne revenez pas aux horaires de sonnerie."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "%lld cours sont liés à des plages des horaires de sonnerie, que les horaires libres n’ont pas. Ils n’apparaissent pas tant que vous ne leur donnez pas une heure de début et de fin ou que vous ne revenez pas aux horaires de sonnerie."
