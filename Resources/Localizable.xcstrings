            "value" : "Erinnerungen werden in einem späteren Update konfiguriert. Es ist noch nichts geplant, und Tabula hat keine Erlaubnis angefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reminders are configured in a later update. Nothing is scheduled yet, and Tabula has not asked for any permission."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rappels seront configurables dans une prochaine mise à jour. Rien n’est encore programmé et Tabula n’a demandé aucune autorisation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az emlékeztetők beállítása egy későbbi frissítésben érkezik. Még semmi sincs ütemezve, és a Tabula nem kért engedélyt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "リマインダーの設定は今後のアップデートで追加されます。まだ何も予定されておらず、Tabulaは許可を求めていません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przypomnienia będą konfigurowane w późniejszej aktualizacji. Nic jeszcze nie jest zaplanowane, a Tabula nie prosiła o żadne zgody."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reamintirile se configurează într-o actualizare ulterioară. Nimic nu este programat încă, iar Tabula nu a cerut nicio permisiune."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pripomienky sa nastavujú v neskoršej aktualizácii. Zatiaľ nie je nič naplánované a Tabula nepožiadala o žiadne povolenie."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Подсетници се подешавају у каснијем ажурирању. Још ништа није заказано, а Tabula није тражила никакву дозволу."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podsetnici se podešavaju u kasnijem ažuriranju. Još ništa nije zakazano, a Tabula nije tražila nikakvu dozvolu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нагадування налаштовуватимуться в пізнішому оновленні. Поки нічого не заплановано, а Tabula не запитувала жодних дозволів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "提醒将在后续更新中配置。目前尚未安排任何提醒，Tabula 也没有请求任何权限。"
          }
        }
      }
    },
    "settings.reminders.quiet.footer" : {
      "comment" : "Footer of the global quiet hours.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Připomínky v tichých hodinách se odloží na jejich konec. Hlasité budíky tyto hodiny ignorují."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erinnerungen in den Ruhezeiten werden bis zu deren Ende zurückgehalten. Laute Alarme ignorieren diese Zeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reminders inside quiet hours are held until they end. Loud alarms ignore these hours."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rappels pendant les heures calmes sont retenus jusqu’à leur fin. Les alarmes sonores ignorent ces heures."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A csendes órák alatti emlékeztetők a végükig várnak. A hangos riasztások figyelmen kívül hagyják ezeket az órákat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "おやすみ時間中のリマインダーは、終了するまで保留されます。大音量アラームにはこの時間帯は適用されません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przypomnienia w godzinach ciszy są wstrzymywane do ich końca. Głośne alarmy ignorują te godziny."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reamintirile din orele de liniște sunt reținute până la sfârșitul lor. Alarmele sonore ignoră aceste ore."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pripomienky v pokojných hodinách sa odložia na ich koniec. Hlasné budíky tieto hodiny ignorujú."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Подсетници у тихим сатима задржавају се до његовог краја. Гласни аларми игноришу ове сате."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podsetnici u tihim satima zadržavaju se do njegovog kraja. Glasni alarmi ignorišu ove sate."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нагадування в тихі години відкладаються до їх завершення. Гучні будильники ці години ігнорують."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "静音时段内的提醒会暂缓到时段结束后发送。响铃闹钟不受这些时段限制。"
          }
        }
      }
    },
