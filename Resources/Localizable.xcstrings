    "settings.reminders.alarms.footer" : {
      "comment" : "Footer of the loud alarm toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hlasitý budík zvoní i přes tichý režim a Soustředění, a to jen v časech, které si zvolíte. iOS žádá o povolení zvlášť. Vyberte ho pro každý druh nebo pro každou položku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein lauter Alarm klingelt trotz Stummschalter und Fokus, nur zu den Zeiten, die du wählst. iOS fragt separat nach der Erlaubnis. Wähle ihn pro Art oder pro Eintrag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A loud alarm rings through the silent switch and Focus, only at the times you choose. iOS asks for permission separately. Choose it per kind or per item."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une alarme sonore sonne malgré le bouton silence et la Concentration, uniquement aux heures que vous choisissez. iOS demande l’autorisation séparément. Choisissez-la par type ou par élément."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A hangos riasztás a néma kapcsoló és a Fókusz ellenére is megszólal, de csak a választott időpontokban. Az iOS külön engedélyt kér. Típusonként vagy tételenként választhatod."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "大音量アラームは、サイレントスイッチや集中モードに関係なく、選んだ時刻にだけ鳴ります。許可はiOSが別途確認します。タイプごと、または項目ごとに選べます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Głośny alarm dzwoni mimo wyciszenia i trybu skupienia, tylko o wybranych przez Ciebie porach. iOS prosi o zgodę osobno. Wybierz go dla rodzaju lub dla pojedynczej pozycji."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O alarmă sonoră sună chiar și cu comutatorul silențios și în Concentrare, doar la orele pe care le alegi. iOS cere permisiunea separat. Alege-o pentru fiecare tip sau pentru fiecare element."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hlasný budík zvoní aj cez tichý režim a Sústredenie, a to iba v časoch, ktoré si zvolíte. iOS žiada o povolenie osobitne. Vyberte ho pre každý druh alebo pre každú položku."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Гласан аларм звони упркос прекидачу за тишину и Фокусу, само у време које изаберете. iOS тражи дозволу посебно. Изаберите га по врсти или по ставци."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Glasan alarm zvoni uprkos prekidaču za tišinu i Fokusu, samo u vreme koje izaberete. iOS traži dozvolu posebno. Izaberite ga po vrsti ili po stavci."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Гучний будильник дзвонить попри перемикач без звуку й фокусування, лише в обрані вами години. iOS окремо запитує дозвіл. Вибирайте його для типу або для окремого пункту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "响铃闹钟不受静音开关和专注模式影响，只在你选择的时间响铃。iOS 会单独请求权限。可按类型或按项目选择。"
          }
        }
      }
    },
