    "settings.calendar.timezone.footer.fixed" : {
      "comment" : "Footer under the time zone setting when a fixed zone is chosen.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Časy hodin vždy používají toto časové pásmo, i když je vaše zařízení jinde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Unterrichtszeiten verwenden immer diese Zeitzone, auch wenn sich dein Gerät woanders befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lesson times always use this time zone, even when your device is somewhere else."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les horaires des cours utilisent toujours ce fuseau horaire, même si votre appareil est ailleurs."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az órák időpontja mindig ezt az időzónát használja, akkor is, ha az eszközöd máshol van."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "デバイスが別の場所にあっても、授業の時刻は常にこのタイムゾーンで表示されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Godziny lekcji zawsze używają tej strefy czasowej, nawet gdy urządzenie jest gdzie indziej."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Orele cursurilor folosesc mereu acest fus orar, chiar dacă dispozitivul tău e în altă parte."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Časy hodín vždy používajú toto časové pásmo, aj keď je vaše zariadenie inde."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Времена часова увек користе ову временску зону, чак и када је ваш уређај негде другде."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vremena časova uvek koriste ovu vremensku zonu, čak i kada je vaš uređaj negde drugde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Час занять завжди використовує цей часовий пояс, навіть якщо ваш пристрій деінде."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "即使设备在其他地方，上课时间也始终使用此时区。"
          }
        }
      }
    },
