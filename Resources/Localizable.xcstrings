        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rappels suggérés ne sonnent jamais comme des alarmes, donc celui-ci arrive sous forme de notification urgente."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A javasolt emlékeztetők sosem szólalnak meg riasztásként, ezért ez időérzékeny értesítésként érkezik."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "おすすめのリマインダーがアラームとして鳴ることはないため、これは即時通知として届きます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sugerowane przypomnienia nigdy nie dzwonią jako alarm, więc to przyjdzie jako powiadomienie pilne."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reamintirile sugerate nu sună niciodată ca alarmă, așa că aceasta va ajunge ca notificare urgentă."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Navrhované pripomienky nikdy nezvonia ako budík, preto táto príde ako časovo citlivé oznámenie."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Предложени подсетници никада не звоне као аларм, па овај стиже као хитно обавештење."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Predloženi podsetnici nikada ne zvone kao alarm, pa ovaj stiže kao hitno obaveštenje."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Запропоновані нагадування ніколи не дзвонять як будильник, тому це надійде як термінове сповіщення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "建议的提醒从不以闹钟形式响铃，因此这个提醒将以时效性通知的形式送达。"
          }
        }
      }
    },
