    "health.silentMode.detail" : {
      "comment" : "Health check hint about Silent mode and the Action button.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "V tichém režimu oznámení nevydávají zvuk. Zvoní jen hlasité budíky. Tichý režim přepnete tlačítkem Akce nebo v Ovládacím centru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Im Stummmodus machen Mitteilungen keinen Ton. Nur laute Alarme klingeln. Den Stummmodus schaltest du mit der Aktionstaste oder im Kontrollzentrum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Silent mode, notifications make no sound. Only loud alarms ring. Switch Silent mode with the Action button or in Control Center."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En mode silencieux, les notifications sont muettes. Seules les alarmes sonores sonnent. Activez ou désactivez le mode silencieux avec le bouton Action ou dans le centre de contrôle."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Néma módban az értesítések nem adnak hangot. Csak a hangos riasztások szólalnak meg. A néma módot a Művelet gombbal vagy a Vezérlőközpontban kapcsolhatod."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "消音モードでは通知の音は鳴りません。鳴るのは大音量アラームだけです。消音モードはアクションボタンまたはコントロールセンターで切り替えられます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "W trybie cichym powiadomienia nie wydają dźwięku. Dzwonią tylko głośne alarmy. Tryb cichy przełączysz przyciskiem czynności lub w centrum sterowania."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "În modul silențios, notificările nu emit sunet. Sună doar alarmele sonore. Comută modul silențios cu butonul Acțiune sau din Centrul de control."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "V tichom režime hlásenia nevydávajú zvuk. Zvonia iba hlasné budíky. Tichý režim prepnete tlačidlom Akcia alebo v Ovládacom centre."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "У нечујном режиму обавештења немају звук. Звоне само гласни аларми. Нечујни режим укључујете дугметом Радња или у Контролном центру."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "U nečujnom režimu obaveštenja nemaju zvuk. Zvone samo glasni alarmi. Nečujni režim uključujete dugmetom Radnja ili u Kontrolnom centru."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "У беззвучному режимі сповіщення не звучать. Дзвонять лише гучні будильники. Перемикайте беззвучний режим кнопкою дії або в Центрі керування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在静音模式下，通知不会发出声音。只有响铃闹钟会响。可以用操作按钮或在控制中心切换静音模式。"
