    "health.lowPower.on" : {
      "comment" : "Health check: Low Power Mode is on.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zapnutý: aktualizace na pozadí jsou pozastavené. Občas otevřete Tabulu, aby byly připomínky aktuální."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein: Hintergrundaktualisierungen sind pausiert. Öffne Tabula ab und zu, damit die Erinnerungen aktuell bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On: background updates are paused. Open Tabula now and then so reminders stay up to date."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activé : les mises à jour en arrière-plan sont suspendues. Ouvrez Tabula de temps en temps pour que vos rappels restent à jour."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bekapcsolva: a háttérfrissítések szünetelnek. Nyisd meg néha a Tabulát, hogy az emlékeztetők naprakészek maradjanak."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オン：バックグラウンドでの更新が一時停止しています。リマインダーを最新に保つため、ときどきTabulaを開いてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Włączony: aktualizacje w tle są wstrzymane. Otwieraj czasem Tabulę, aby przypomnienia były aktualne."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activat: actualizările în fundal sunt întrerupte. Deschide Tabula din când în când ca reamintirile să rămână actualizate."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zapnutý: aktualizácie na pozadí sú pozastavené. Občas otvorte Tabulu, aby boli pripomienky aktuálne."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Укључено: ажурирања у позадини су паузирана. Повремено отворите Tabula да би подсетници остали ажурни."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uključeno: ažuriranja u pozadini su pauzirana. Povremeno otvorite Tabula da bi podsetnici ostali ažurni."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Увімкнено: оновлення у фоні призупинено. Іноді відкривайте Tabula, щоб нагадування залишалися актуальними."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "已打开：后台更新已暂停。请不时打开 Tabula，让提醒保持最新。"
          }
        }
      }
    },
