    "health.focus.detail" : {
      "comment" : "Health check hint about Focus allow-lists. Keep the Settings path in Apple's wording for your language.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chcete-li dostávat připomínky i během Soustředění, přidejte Tabulu mezi povolené aplikace v Nastavení → Soustředění. Hlasité budíky zvoní vždy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Damit du während eines Fokus Erinnerungen bekommst, füge Tabula unter Einstellungen → Fokus zu den erlaubten Apps hinzu. Laute Alarme klingeln immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To get reminders during a Focus, add Tabula to its allowed apps in Settings → Focus. Loud alarms always ring."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour recevoir des rappels pendant une Concentration, ajoutez Tabula aux apps autorisées dans Réglages → Concentration. Les alarmes sonores sonnent toujours."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ha Fókusz közben is szeretnél emlékeztetőket kapni, add hozzá a Tabulát az engedélyezett alkalmazásokhoz a Beállítások → Fókusz menüben. A hangos riasztások mindig megszólalnak."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "集中モード中にもリマインダーを受け取るには、「設定」→「集中モード」で通知を許可するAppにTabulaを追加してください。大音量アラームは常に鳴ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aby otrzymywać przypomnienia w trybie skupienia, dodaj Tabulę do dozwolonych aplikacji w Ustawieniach → Skupienie. Głośne alarmy dzwonią zawsze."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pentru a primi reamintiri în timpul unei Concentrări, adaugă Tabula la aplicațiile permise în Setări → Concentrare. Alarmele sonore sună întotdeauna."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ak chcete dostávať pripomienky aj počas režimu Sústredenie, pridajte Tabulu medzi povolené aplikácie v Nastaveniach → Sústredenie. Hlasné budíky zvonia vždy."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Да бисте добијали подсетнике током Фокуса, додајте Tabula у дозвољене апликације у Подешавањима → Фокус. Гласни аларми увек звоне."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Da biste dobijali podsetnike tokom Fokusa, dodajte Tabula u dozvoljene aplikacije u Podešavanjima → Fokus. Glasni alarmi uvek zvone."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Щоб отримувати нагадування під час Фокусування, додайте Tabula до дозволених застосунків у Параметрах → Фокусування. Гучні будильники дзвонять завжди."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "若要在专注模式期间收到提醒，请在“设置”→“专注模式”中将 Tabula 添加到允许的 App。响铃闹钟总会响。"
          }
        }
      }
    },
