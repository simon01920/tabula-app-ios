    "store.banner.restored.message" : {
      "comment" : "Banner text under 'Data restored from a backup'.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Váš rozvrh byl poškozen, proto se načetla poslední dobrá kopie. Změny z posledního okamžiku mohou chybět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dein Stundenplan war beschädigt, daher wurde die letzte intakte Kopie geladen. Kurz zuvor vorgenommene Änderungen könnten fehlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your timetable was damaged, so the last good copy was loaded. Changes made just before may be missing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre emploi du temps était endommagé, la dernière bonne copie a donc été chargée. Les modifications faites juste avant peuvent manquer."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az órarended megsérült, ezért az utolsó jó másolat lett betöltve. A közvetlenül előtte végzett módosítások hiányozhatnak."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "時間割が破損していたため、最後の正常なコピーを読み込みました。直前の変更が反映されていない可能性があります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twój plan został uszkodzony, więc wczytano ostatnią dobrą kopię. Zmiany wprowadzone tuż przed tym mogą zostać utracone."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Orarul tău era deteriorat, așa că s-a încărcat ultima copie bună. Modificările făcute chiar înainte pot lipsi."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Váš rozvrh bol poškodený, preto sa načítala posledná dobrá kópia. Zmeny z posledného okamihu môžu chýbať."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваш распоред је био оштећен, па је учитана последња исправна копија. Измене начињене непосредно пре тога можда недостају."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaš raspored je bio oštećen, pa je učitana poslednja ispravna kopija. Izmene načinjene neposredno pre toga možda nedostaju."
          }
        },
        "uk" : {
          "stringUnit" : {
