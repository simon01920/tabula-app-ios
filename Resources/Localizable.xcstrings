    "reminder.tierChange.presetRuleAlarm" : {
      "comment" : "Explanation in the reminder health check. 'Time Sensitive' is Apple's notification level name. No arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Navrhované připomínky nikdy nezvoní jako budík, proto tato přijde jako časově citlivé oznámení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vorgeschlagene Erinnerungen klingeln nie als Alarm, daher kommt diese als zeitkritische Mitteilung an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggested reminders never ring as alarms, so this one arrives as a Time Sensitive notification."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rappels suggérés ne sonnent jamais comme des alarmes, donc celui-ci arrive sous forme de notification urgente."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A javasolt emlékeztetők sosem szólalnak meg riasztásként, ezért ez időérzékeny értesítésként érkezik."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "おすすめのリマインダーがアラームとして鳴ることはないため、これは即時通知として届きます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sugerowane przypomnienia nigdy nie dzwonią jako alarm, więc to przyjdzie jako powiadomienie pilne."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reamintirile sugerate nu sună niciodată ca alarmă, așa că aceasta va ajunge ca notificare urgentă."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Navrhované pripomienky nikdy nezvonia ako budík, preto táto príde ako časovo citlivé oznámenie."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Предложени подсетници никада не звоне као аларм, па овај стиже као хитно обавештење."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
