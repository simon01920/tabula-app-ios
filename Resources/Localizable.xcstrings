    "onboarding.reminders.tier.timeSensitive.body" : {
      "comment" : "Honest explanation of Time Sensitive notifications.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doručí se okamžitě a může projít přes Soustředění, pokud této aplikaci povolíte časově citlivá oznámení. Tichý režim zvuk stále ztlumí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wird sofort zugestellt und kann durch den Fokus dringen, wenn du zeitkritische Mitteilungen für diese App erlaubst. Der Stummschalter schaltet den Ton trotzdem stumm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delivered right away and can come through Focus if you allow Time Sensitive notifications for this app. The silent switch still mutes the sound."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Distribuée immédiatement, elle peut passer malgré une Concentration si vous autorisez les notifications urgentes pour cette app. Le bouton silence coupe quand même le son."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Azonnal megérkezik, és átjuthat a Fókuszon, ha engedélyezed ennél az alkalmazásnál az időérzékeny értesítéseket. A néma kapcsoló továbbra is elnémítja a hangot."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dostarczane od razu i może przebić się przez tryb skupienia, jeśli zezwolisz tej aplikacji na powiadomienia pilne. Przełącznik wyciszenia nadal wycisza dźwięk."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Livrată imediat și poate trece prin Concentrare dacă permiți notificările urgente pentru această aplicație. Comutatorul de sunet tot dezactivează sunetul."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doručené okamžite a môže prejsť cez Sústredenie, ak tejto aplikácii povolíte časovo citlivé oznámenia. Tichý režim stále stlmí zvuk."
          }
        }
      }
    },
