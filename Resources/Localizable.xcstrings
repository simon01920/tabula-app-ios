            "state" : "needs_review",
            "value" : "Aplikace používá jazyk vašeho iPhonu. Jiný jazyk pro tuto aplikaci můžete vybrat v Nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die App verwendet die Sprache deines iPhone. Für diese App kannst du in den Einstellungen eine andere Sprache wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app uses your iPhone's language. You can choose a different language for this app in Settings."
