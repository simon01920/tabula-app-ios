        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Testowe powiadomienie dotrze za kilka sekund. Zablokuj telefon, aby zobaczyć, jak wygląda na ekranie blokady. Testowy alarm zadzwoni za minutę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
