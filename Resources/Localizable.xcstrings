        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Časy hodín vždy používajú toto časové pásmo, aj keď je vaše zariadenie inde."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
