    "health.tests.footer" : {
      "comment" : "Footer of the test section.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Testovací oznámení přijde za několik sekund. Zamkněte telefon a uvidíte, jak vypadá na zamčené obrazovce. Testovací budík zazvoní za minutu."
