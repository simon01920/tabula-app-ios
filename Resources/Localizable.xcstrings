    "health.backgroundRefresh.denied" : {
      "comment" : "Health check: Background App Refresh is off for Tabula.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vypnuto: Tabula aktualizuje připomínky, jen když ji používáte. Zapněte aktualizace na pozadí v Nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aus: Tabula aktualisiert Erinnerungen nur, während du die App nutzt. Aktiviere die Hintergrundaktualisierung in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: Tabula updates reminders only while you use it. Turn on Background App Refresh in Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Désactivée : Tabula ne met à jour les rappels que lorsque vous l’utilisez. Activez l’actualisation en arrière-plan dans Réglages."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kikapcsolva: a Tabula csak használat közben frissíti az emlékeztetőket. Kapcsold be a háttérfrissítést a Beállításokban."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オフ：Tabulaは使用中にしかリマインダーを更新できません。設定でAppのバックグラウンド更新をオンにしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wyłączone: Tabula aktualizuje przypomnienia tylko podczas używania. Włącz odświeżanie w tle w Ustawieniach."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
