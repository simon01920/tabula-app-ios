    "health.hiddenApp.detail" : {
      "comment" : "Health check: iOS silently skips alarms of apps that are hidden or need Face ID to open.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hlasité budíky nezazvoní, pokud je Tabula skrytá nebo zamčená pomocí Face ID."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laute Alarme klingeln nicht, wenn Tabula ausgeblendet oder mit Face ID gesperrt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loud alarms don't ring if Tabula is hidden or locked with Face ID."
          }
