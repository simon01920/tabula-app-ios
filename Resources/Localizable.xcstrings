        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A módosításaid addig megmaradnak, amíg a Tabula nyitva van, és a mentést a következő módosításnál újra megpróbáljuk. Ellenőrizd, hogy van-e szabad hely az iPhone-odon."
          }
