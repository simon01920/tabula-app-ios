        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Każdy wpis ma własny czas rozpoczęcia i zakończenia. Nowe wpisy mają długość podaną poniżej."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
