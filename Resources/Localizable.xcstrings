          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Запропоновані нагадування ніколи не дзвонять як будильник, тому це надійде як термінове сповіщення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
