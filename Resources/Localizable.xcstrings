    "onboarding.reminders.tier.alarm.body" : {
      "comment" : "Honest explanation of loud alarms (AlarmKit): bypass silent switch and Focus, separate permission, opt-in.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro věci, které nesmíte zmeškat. Zvoní i při vypnutém zvuku a přes Soustředění, ale později si vyžádá vlastní oprávnění a ve výchozím stavu je vypnuté."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Für Dinge, die du nicht verpassen darfst. Klingelt auch bei aktivem Stummschalter und trotz Fokus, braucht aber später eine eigene Erlaubnis und ist standardmäßig aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For things you must not miss. It rings even with the silent switch on and through Focus, but needs its own permission later and is off by default."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour ce que vous ne devez pas manquer. Sonne même avec le bouton silence activé et malgré les Concentrations, mais demande plus tard sa propre autorisation et est désactivée par défaut."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Olyan dolgokhoz, amiket nem szabad lekésned. Néma kapcsoló mellett és Fókusz módban is megszólal, de később külön engedélyt kér, és alapból ki van kapcsolva."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dla rzeczy, których nie możesz przegapić. Dzwoni nawet przy wyciszonym telefonie i w trybach skupienia, ale później wymaga osobnej zgody i domyślnie jest wyłączony."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pentru lucrurile pe care nu trebuie să le ratezi. Sună chiar și cu comutatorul de sunet oprit și prin Concentrare, dar cere mai târziu o permisiune separată și este dezactivată implicit."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pre veci, ktoré nesmiete zmeškať. Zvoní aj pri vypnutom zvuku a cez režim Sústredenie, no neskôr si vyžiada vlastné povolenie a predvolene je vypnuté."
          }
        }
      }
    },
    "onboarding.reminders.tier.alarm.title" : {
      "comment" : "Delivery type name: alarm that rings like the Clock app.",
      "extractionState" : "manual",
