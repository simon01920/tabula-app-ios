    "settings.profile.footer" : {
      "comment" : "Footer under the profile settings.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Změna profilu nemění existující rozvrhy ani hodiny. Ovlivní jen návrhy a formulace u nových."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Profiländerung ändert keine bestehenden Stundenpläne oder Stunden. Sie betrifft nur Vorschläge und Formulierungen für neue."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing your profile does not change existing timetables or lessons. It only affects suggestions and wording for new ones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Changer de profil ne modifie ni les emplois du temps ni les cours existants. Cela n’affecte que les suggestions et la formulation des nouveaux."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A profil módosítása nem változtatja meg a meglévő órarendeket és órákat. Csak az újak javaslataira és megfogalmazására hat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "プロフィールを変更しても、既存の時間割や授業は変わりません。新しく作るものの提案と表現にだけ影響します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zmiana profilu nie zmienia istniejących planów ani lekcji. Wpływa tylko na propozycje i sformułowania w nowych."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schimbarea profilului nu modifică orarele sau orele existente. Afectează doar sugestiile și formulările pentru cele noi."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zmena profilu nemení existujúce rozvrhy ani hodiny. Ovplyvní iba návrhy a formulácie pri nových."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Промена профила не мења постојеће распореде и часове. Утиче само на предлоге и формулације за нове."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Promena profila ne menja postojeće rasporede i časove. Utiče samo na predloge i formulacije za nove."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зміна профілю не змінює наявні розклади й уроки. Вона впливає лише на пропозиції та формулювання для нових."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "更改身份不会改变已有的课程表或课程，只影响新建内容的建议和措辞。"
          }
        }
      }
