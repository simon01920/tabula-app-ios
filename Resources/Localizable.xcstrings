    "onboarding.reminders.subtitle" : {
      "comment" : "Onboarding reminders step explanation. No permission is requested in onboarding.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyberte, na co chcete upozorňovat. O povolení oznámení aplikace požádá později, až ho budete potřebovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle, woran du erinnert werden möchtest. Die App fragt erst später nach der Erlaubnis für Mitteilungen, wenn du sie brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what you want to be reminded about. The app asks for notification permission later, when you first need it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez ce dont vous voulez être averti. L’app demandera l’autorisation d’envoyer des notifications plus tard, quand vous en aurez besoin."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Válaszd ki, miről kérsz emlékeztetőt. Az értesítési engedélyt az alkalmazás később kéri, amikor szükség lesz rá."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wybierz, o czym mamy przypominać. Aplikacja poprosi o zgodę na powiadomienia później, gdy będzie potrzebna."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alege despre ce vrei să primești reamintiri. Aplicația cere permisiunea pentru notificări mai târziu, când ai nevoie de ea."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyberte, na čo vám máme pripomínať. O povolenie na oznámenia aplikácia požiada neskôr, až keď ho budete potrebovať."
          }
        }
      }
    },
