    "editor.timetables.delete.note" : {
      "comment" : "Explanation in the delete-timetable confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toto nelze vrátit. Domácí úkoly a zkoušky zůstanou, ale ztratí propojení s tímto rozvrhem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das lässt sich nicht rückgängig machen. Hausaufgaben und Prüfungen bleiben erhalten, verlieren aber ihre Verknüpfung zu diesem Stundenplan."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This can't be undone. Homework and exams are kept, but they lose their link to this timetable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cette action est irréversible. Les devoirs et examens sont conservés, mais perdent leur lien avec cet emploi du temps."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ez nem vonható vissza. A házi feladatok és vizsgák megmaradnak, de megszűnik a kapcsolatuk ezzel az órarenddel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この操作は取り消せません。宿題と試験は残りますが、この時間割との関連付けは外れます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tego nie można cofnąć. Prace domowe i egzaminy zostaną, ale stracą powiązanie z tym planem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Această acțiune nu poate fi anulată. Temele și examenele se păstrează, dar își pierd legătura cu acest orar."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toto sa nedá vrátiť. Domáce úlohy a skúšky zostanú, ale stratia prepojenie na tento rozvrh."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ово не може да се поништи. Домаћи задаци и испити се задржавају, али губе везу са овим распоредом."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ovo ne može da se poništi. Domaći zadaci i ispiti se zadržavaju, ali gube vezu sa ovim rasporedom."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Це неможливо скасувати. Домашні завдання та іспити збережуться, але втратять зв’язок із цим розкладом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此操作无法撤销。作业和考试会保留，但会解除与此课程表的关联。"
          }
        }
      }
    },
