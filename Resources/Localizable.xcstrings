    "editor.timetables.last.footer" : {
      "comment" : "Explains why delete is disabled for the only timetable.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula potřebuje alespoň jeden rozvrh, proto nelze smazat poslední. Místo toho jej vynulujte, aby se vymazaly jeho hodiny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula braucht mindestens einen Stundenplan, daher kann der letzte nicht gelöscht werden. Setze ihn stattdessen zurück, um seine Stunden zu leeren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabula needs at least one timetable, so the last one can't be deleted. Reset it to clear its lessons instead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula a besoin d’au moins un emploi du temps, donc le dernier ne peut pas être supprimé. Réinitialisez-le plutôt pour effacer ses cours."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Tabulának legalább egy órarendre szüksége van, ezért az utolsó nem törölhető. Helyette állítsd alaphelyzetbe, hogy kiürüljenek az órái."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabulaには時間割が最低1つ必要なため、最後の1つは削除できません。代わりにリセットして授業を消去してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula potrzebuje co najmniej jednego planu, więc ostatniego nie można usunąć. Zamiast tego zresetuj go, aby wyczyścić jego zajęcia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula are nevoie de cel puțin un orar, deci ultimul nu poate fi șters. Resetează-l ca să-i ștergi orele."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula potrebuje aspoň jeden rozvrh, preto sa posledný nedá odstrániť. Namiesto toho ho vynulujte, aby sa vymazali jeho hodiny."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula захтева бар један распоред, па последњи не може да се обрише. Уместо тога ресетујте га да бисте очистили његове часове."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula zahteva bar jedan raspored, pa poslednji ne može da se obriše. Umesto toga resetujte ga da biste očistili njegove časove."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula потрібен принаймні один розклад, тому останній видалити не можна. Натомість скиньте його, щоб очистити уроки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabula 至少需要一个课程表，因此无法删除最后一个。请改为重置它，以清除其中的课程。"
          }
        }
      }
    },
