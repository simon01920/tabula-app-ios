      "comment" : "Banner text under 'Update Tabula to make changes'.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tato data uložila novější verze aplikace Tabula. Můžete si je prohlédnout, ale změny jsou vypnuté, dokud aplikaci neaktualizujete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diese Daten wurden von einer neueren Version von Tabula gespeichert. Du kannst sie ansehen, aber Änderungen sind bis zum Update der App ausgeschaltet."
          }
        },
        "en" : {
