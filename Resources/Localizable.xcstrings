        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minden bejegyzésnek saját kezdete és vége van. Az új bejegyzések az alább megadott hosszal indulnak."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各項目に開始時刻と終了時刻を個別に設定できます。新しい項目は下の長さで始まります。"
