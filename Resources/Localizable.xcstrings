    "onboarding.time.free.message" : {
      "comment" : "Onboarding: explanation of the free-form time structure.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Každý záznam má vlastní začátek a konec. Nové záznamy začínají s délkou uvedenou níže."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeder Eintrag hat eine eigene Start- und Endzeit. Neue Einträge beginnen mit der unten gewählten Länge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
