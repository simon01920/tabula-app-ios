    "settings.reminders.standard.detail" : {
      "comment" : "Explanation of the Standard reminder type.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Běžné oznámení. Doručuje se jako každé jiné oznámení aplikace a Soustředění ho může zadržet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine normale Mitteilung. Sie wird wie jede andere App-Mitteilung zugestellt und kann von einem Fokus zurückgehalten werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A normal notification. It is delivered like any other app notification and can be held back by a Focus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une notification normale. Elle est distribuée comme n’importe quelle notification d’app et peut être retenue par une Concentration."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Egy szokásos értesítés. Úgy érkezik, mint bármely más alkalmazásértesítés, és a Fókusz visszatarthatja."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zwykłe powiadomienie. Jest dostarczane jak każde inne powiadomienie aplikacji i tryb skupienia może je wstrzymać."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O notificare obișnuită. Este livrată ca orice altă notificare de aplicație și poate fi reținută de Concentrare."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bežné oznámenie. Doručuje sa ako každé iné oznámenie aplikácie a režim Sústredenie ho môže zadržať."
          }
        }
      }
    },
