    "settings.reminders.timesensitive.detail" : {
      "comment" : "Explanation of the Time Sensitive reminder type.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doručí se okamžitě a může projít přes Soustředění nebo souhrn oznámení, pokud pro Tabulu povolíte časově citlivá oznámení v Nastavení iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wird sofort zugestellt und kann einen Fokus oder die Mitteilungszusammenfassung durchbrechen, wenn du zeitkritische Mitteilungen für Tabula in den iOS-Einstellungen erlaubst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delivered right away and can break through a Focus or the notification summary, if you allow Time Sensitive notifications for Tabula in iOS Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Distribuée immédiatement, elle peut passer malgré une Concentration ou le résumé de notifications, si vous autorisez les notifications urgentes pour Tabula dans les Réglages d’iOS."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Azonnal megérkezik, és átjuthat a Fókuszon vagy az értesítési összefoglalón, ha az iOS Beállításokban engedélyezed a Tabula időérzékeny értesítéseit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dostarczane od razu i może przebić się przez tryb skupienia lub zestawienie powiadomień, jeśli zezwolisz Tabuli na powiadomienia pilne w Ustawieniach iOS."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Livrată imediat și poate trece prin Concentrare sau prin rezumatul notificărilor, dacă permiți notificările urgente pentru Tabula în Setările iOS."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doručené okamžite a môže prejsť cez režim Sústredenie alebo súhrn oznámení, ak pre Tabulu povolíte časovo citlivé oznámenia v Nastaveniach iOS."
          }
        }
      }
    },
