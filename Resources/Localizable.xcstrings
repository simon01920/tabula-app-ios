    "attachments.delete.message" : {
      "comment" : "Message of the delete-attachment confirmation: removal takes effect only when the task is saved.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Z úkolu se odstraní po uložení. Pokud ji chcete ponechat, zrušte úpravy úkolu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Er wird beim Sichern aus der Aufgabe entfernt. Brich die Bearbeitung ab, um ihn zu behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is removed from the task when you save. Cancel the task editor to keep it."
          }
