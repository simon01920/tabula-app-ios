    "reminders.tier.timeSensitive.off" : {
      "comment" : "Shown under the Time Sensitive tier when the user turned the policy off.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Časově citlivé jsou v nastavení připomínek vypnuté, proto přijdou jako standardní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeitkritisch ist in den Erinnerungseinstellungen ausgeschaltet, daher kommen diese als Standard an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Sensitive is turned off in Reminders settings, so these arrive as Standard."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Urgentes est désactivé dans les réglages des rappels, donc ceux-ci arrivent en standard."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az időérzékeny az emlékeztetők beállításaiban ki van kapcsolva, ezért ezek normálként érkeznek."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "リマインダー設定で即時通知がオフのため、これらは通常として届きます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilne są wyłączone w ustawieniach przypomnień, więc przychodzą jako standardowe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Urgentele sunt dezactivate în setările reamintirilor, așa că acestea ajung ca standard."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Časovo citlivé sú v nastaveniach pripomienok vypnuté, preto prídu ako štandardné."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хитно је искључено у подешавањима подсетника, па стижу као стандардно."
          }
        },
        "sr-Latn" : {
