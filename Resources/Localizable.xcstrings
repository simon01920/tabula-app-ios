    "settings.reminders.silent.detail" : {
      "comment" : "Explains the iPhone ring/silent switch.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Standardní a časově citlivé připomínky se řídí přepínačem vyzvánění a ticha. Pouze hlasitý budík zvoní bez ohledu na to."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Standard- und zeitkritische Erinnerungen folgen für den Ton dem Klingeln/Stumm-Schalter. Nur ein lauter Alarm klingelt in jedem Fall."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard and Time Sensitive reminders follow the ring/silent switch for sound. Only a loud alarm is made to ring regardless."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rappels standard et urgents suivent le bouton sonnerie/silence pour le son. Seule une alarme sonore sonne dans tous les cas."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A normál és az időérzékeny emlékeztetők hangja a csengő/néma kapcsolót követi. Csak a hangos riasztás szólal meg minden esetben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przypomnienia standardowe i pilne podlegają przełącznikowi dzwonka i wyciszenia. Tylko głośny alarm dzwoni niezależnie od niego."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reamintirile standard și cele urgente urmează comutatorul de sunet/silențios pentru sunet. Doar o alarmă sonoră sună indiferent."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Štandardné a časovo citlivé pripomienky sa riadia prepínačom zvonenia a ticha. Iba hlasný budík zvoní bez ohľadu na to."
          }
        }
      }
    },
