    "reminder.tierChange.alarmLimitReached" : {
      "comment" : "Explanation in the reminder health check. No arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
