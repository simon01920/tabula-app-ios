    "editor.rotation.locked.footer" : {
      "comment" : "Footer when the rotation family is locked.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tento rozvrh má hodiny, proto nelze přepínat mezi dny v týdnu a cyklem dnů. Nejprve rozvrh vynulujte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Stundenplan hat Stunden, daher kann er nicht zwischen Wochentagen und einem Tageszyklus wechseln. Setze den Stundenplan zuerst zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This timetable has lessons, so it can't switch between weekdays and a day cycle. Reset the timetable first."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cet emploi du temps contient des cours, il ne peut donc pas passer des jours de la semaine à un cycle de jours. Réinitialisez-le d’abord."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ennek az órarendnek vannak órái, ezért nem váltható át hétköznapok és napciklus között. Előbb állítsd alaphelyzetbe az órarendet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この時間割には授業があるため、曜日方式と日のサイクルを切り替えられません。先に時間割をリセットしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ten plan ma zajęcia, więc nie można przełączać między dniami tygodnia a cyklem dni. Najpierw zresetuj plan."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acest orar are ore, deci nu poate trece între zilele săptămânii și un ciclu de zile. Resetează mai întâi orarul."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tento rozvrh má hodiny, preto sa nedá prepnúť medzi dňami v týždni a cyklom dní. Najprv rozvrh vynulujte."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Овај распоред има часове, па не може да се пребацује између дана у седмици и циклуса дана. Прво ресетујте распоред."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ovaj raspored ima časove, pa ne može da se prebacuje između dana u sedmici i ciklusa dana. Prvo resetujte raspored."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "У цьому розкладі є уроки, тому його не можна перемикати між днями тижня й циклом днів. Спершу скиньте розклад."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此课程表已有课程，因此无法在星期制与日循环之间切换。请先重置课程表。"
          }
        }
      }
    },
